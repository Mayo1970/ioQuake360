-		return status;
-	}
 	old_surface = (Surface){
 		.address = gpu_registers[D1GRPH_PRIMARY_SURFACE_ADDRESS],
 		.pitch = gpu_registers[D1GRPH_PITCH],
 		.x_end = gpu_registers[D1GRPH_X_END],
 		.y_end = gpu_registers[D1GRPH_Y_END],
 	};
+	if (!blank) {
+		const uint32_t blank_bytes = xsdk_gpu_resolve_bytes(old_surface.pitch, old_surface.y_end);
+		blank = xsdk_gpu_alloc(blank_bytes);
+		if (!blank) {
+			xsdk_log_write("display: no memory for the black surface");
+		} else {
+			for (uint32_t i = 0; i < blank_bytes / 4; i++)
+				blank[i] = BLANK_BLACK;
+			__asm__ volatile("sync" ::: "memory");
+			blank_address = xsdk_gpu_address(blank);
+		}
+	}
+	if (blank) {
+		const Surface surface = { .address = blank_address, .pitch = old_surface.pitch, .x_end = old_surface.x_end,
+			.y_end = old_surface.y_end };
+		const NTSTATUS blank_status = apply(&surface);
+		if (!NT_SUCCESS(blank_status))
+			xsdk_log_write("display: the black surface didn't show: 0x%08X", (unsigned)blank_status);
+	}
+	const NTSTATUS status = fill_lut();
+	if (!NT_SUCCESS(status)) {
+		xsdk_log_write("display: the LUT autofill didn't finish: 0x%08X", (unsigned)status);
+		return status;
+	}
