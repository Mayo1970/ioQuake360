+// Black stand-in for XAM's surface at address 0, kept until xsdk_gpu_close hands the display back to XAM.
+static volatile uint32_t *blank;
+static uint32_t blank_address;
 
 // libxenon's autofill of a linear ramp; the screen stays black without it (libxenon:drivers/xenos/xenos.c:419-424).
 static NTSTATUS fill_lut(void)
@@ -209,6 +214,8 @@ bool xsdk_display_plan(uint32_t width, uint32_t height, uint32_t pitch, DisplayS
 	return true;
 }
 
+static NTSTATUS apply(const Surface *surface);
