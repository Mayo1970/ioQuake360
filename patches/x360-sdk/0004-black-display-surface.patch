-	(void)apply(&old_surface);
+	if (blank) {
+		const Surface surface = { .address = blank_address, .pitch = old_surface.pitch, .x_end = old_surface.x_end,
+			.y_end = old_surface.y_end };
+		(void)apply(&surface);
+	} else {
+		(void)apply(&old_surface);
+	}
 	is_open = false;
 }
+
+void xsdk_display_release_blank(void)
+{
+	if (blank)
+		xsdk_gpu_free(blank);
+	blank = NULL;
+	blank_address = 0;
+}
