+
+bool xsdk_xsc_specialization_needs(Xsc *x, const XscInterface *si, XscLowered *out)
+{
+	for (size_t i = 0; i < si->specialization_count; i++) {
+		const XscSpecialization *const spec = &si->specializations[i];
+		const XsdkXscNeed need = { .kind = XSDK_XSC_SPECIALIZATION,
+			.reg = spec->reg,
+			.regs = 1,
+			.constant_id = spec->constant_id,
+			.scalar_type = spec->scalar_type,
+			.default_value = spec->default_value };
+		if (!xsdk_xsc_add_need(x, out, need))
+			return false;
+	}
+	return true;
+}
+
+bool xsdk_xsc_specialization_budget(Xsc *x, const XscInterface *si, uint32_t registers, const char *stage)
+{
+	for (size_t i = 0; i < si->specialization_count; i++) {
+		if (si->specializations[i].reg >= registers)
+			return xsdk_xsc_fail(x, XSDK_XSC_REGISTERS, "%s specialization constant c%u exceeds its %u-register share",
+				stage, (unsigned)si->specializations[i].reg, (unsigned)registers);
+	}
+	return true;
+}
