+static bool specialization_default(Xsc *x, const XscModule *m, const XscType *types, const XscInstr *ins,
+	XsdkXscSpecializationType *scalar_type, double *default_value)
+{
+	const XscType *const result = xsdk_xsc_type(m, types, ins->result_type);
+	if (ins->opcode == SPV_SPEC_CONSTANT_TRUE || ins->opcode == SPV_SPEC_CONSTANT_FALSE) {
+		if (!result || result->kind != XSC_TYPE_BOOL)
+			return xsdk_xsc_fail(
+				x, XSDK_XSC_REFUSED, "a specialization constant must be a scalar bool, int, uint or float");
+		*scalar_type = XSDK_XSC_SPEC_BOOL;
+		*default_value = ins->opcode == SPV_SPEC_CONSTANT_TRUE ? 1.0 : 0.0;
+		return true;
+	}
+	if (!result || (result->kind != XSC_TYPE_INT && result->kind != XSC_TYPE_FLOAT) || !xsdk_xsc_operand_count(ins))
+		return xsdk_xsc_fail(
+			x, XSDK_XSC_REFUSED, "a specialization constant must be a scalar bool, int, uint or float");
+	const XscInstr *const type = xsdk_xsc_by_result(m, ins->result_type);
+	if (!type || (type->opcode != SPV_TYPE_INT && type->opcode != SPV_TYPE_FLOAT) || xsdk_xsc_operand(type, 0) != 32)
+		return xsdk_xsc_fail(x, XSDK_XSC_REFUSED, "specialization constants must be 32-bit scalars");
+	const uint32_t bits = xsdk_xsc_operand(ins, 0);
+	if (result->kind == XSC_TYPE_FLOAT) {
+		*scalar_type = XSDK_XSC_SPEC_FLOAT;
+		*default_value = xsdk_xsc_float_bits(bits);
+		return true;
+	}
+	const bool is_signed = xsdk_xsc_operand_count(type) > 1 && xsdk_xsc_operand(type, 1) != 0;
+	*scalar_type = is_signed ? XSDK_XSC_SPEC_INT : XSDK_XSC_SPEC_UINT;
+	*default_value = is_signed && (bits & 0x80000000u) ? (double)((int64_t)bits - 0x100000000LL) : (double)bits;
+	return true;
+}
