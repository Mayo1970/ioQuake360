+def xdbf_blob(title_name, icon):
+    blocks = [(XDBF_NAMESPACE_METADATA, XDBF_ID_METADATA, struct.pack(">4sIII", b"XSTC", 1, 4, LANGUAGE_ENGLISH))]
+    if icon is not None:
+        blocks.append((XDBF_NAMESPACE_IMAGE, XDBF_ID_TITLE_ICON, icon))
+    if title_name is not None:
+        name = title_name.encode()
+        body = struct.pack(">HHH", 1, XDBF_ID_TITLE_STRING, len(name)) + name
+        blocks.append((XDBF_NAMESPACE_STRINGS, LANGUAGE_ENGLISH, struct.pack(">4sII", b"XSTR", 1, len(body)) + body))
+
+    blocks.sort(key=lambda block: block[:2])
+    entries = b""
+    content = b""
+    for namespace, block_id, data in blocks:
+        entries += XDBF_ENTRY.pack(namespace, block_id, len(content), len(data))
+        content += data
+    # One free entry, after the content.
+    free = XDBF_FREE.pack(len(content), 0xFFFFFFFF - len(content))
+    return XDBF_HEADER.pack(b"XDBF", XDBF_VERSION, len(blocks), len(blocks), 1, 1) + entries + free + content
+
