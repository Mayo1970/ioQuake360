+def title_section(sections, title_name, icon):
+    # Starts a fresh 64 KB page, so the XDBF never shares a page with code or data.
+    end = max(s["address"] + s["size"] for s in sections if s["flags"] & SHF_ALLOC)
+    blob = xdbf_blob(title_name, icon)
+    return {"name": ".xdbf", "kind": SHT_PROGBITS, "flags": SHF_ALLOC, "address": align(end, PAGE_BYTES),
+        "data": blob, "size": len(blob)}
+
