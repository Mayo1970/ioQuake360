diff --git a/tests/test_specialization.c b/tests/test_specialization.c
new file mode 100644
index 0000000000000000000000000000000000000000..071239b8b72099d25d8f6253d57ba1112951d5ad
--- /dev/null
+++ b/tests/test_specialization.c
@@ -0,0 +1,65 @@
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "harness.h"
+#include "shaders.h"
+#include "tests.h"
+
+enum {
+	VERTEX_FLOATS = 8,
+	STRIDE_BYTES = VERTEX_FLOATS * 4,
+	COLOR_OFFSET_BYTES = 16,
+};
+
+static const VkVertexInputBindingDescription binding = { 0, STRIDE_BYTES, VK_VERTEX_INPUT_RATE_VERTEX };
+static const VkVertexInputAttributeDescription attributes[] = {
+	{ .location = 0, .binding = 0, .format = VK_FORMAT_R32G32B32A32_SFLOAT, .offset = 0 },
+	{ .location = 1, .binding = 0, .format = VK_FORMAT_R32G32B32A32_SFLOAT, .offset = COLOR_OFFSET_BYTES },
+};
+
+void test_specialization(const Harness *harness)
+{
+	const struct {
+		float brightness;
+		int32_t mode;
+	} values = { 0.5f, 1 };
+	const VkSpecializationMapEntry entries[] = {
+		{ .constantID = 0, .offset = 0, .size = sizeof values.brightness },
+		{ .constantID = 1, .offset = sizeof values.brightness, .size = sizeof values.mode },
+	};
+	const VkSpecializationInfo specialization = {
+		.mapEntryCount = 2,
+		.pMapEntries = entries,
+		.dataSize = sizeof values,
+		.pData = &values,
+	};
+	const VkPipelineLayoutCreateInfo layout_info = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+	VkPipelineLayout layout = VK_NULL_HANDLE;
+	VkRenderPass render_pass = VK_NULL_HANDLE;
+	VkFramebuffer framebuffers[HARNESS_MAX_IMAGES];
+	VkPipeline pipeline = VK_NULL_HANDLE;
+	bool ok = harness_ok("pipeline layout", vkCreatePipelineLayout(harness->device, &layout_info, NULL, &layout));
+	ok = ok && harness_ok("render pass", harness_render_pass(harness, &render_pass, framebuffers));
+	const HarnessPipeline spec = {
+		.vertex_spirv = triangle_vert_spirv,
+		.vertex_bytes = TRIANGLE_VERT_SPIRV_BYTES,
+		.fragment_spirv = triangle_frag_spirv,
+		.fragment_bytes = TRIANGLE_FRAG_SPIRV_BYTES,
+		.bindings = &binding,
+		.binding_count = 1,
+		.attributes = attributes,
+		.attribute_count = 2,
+		.layout = layout,
+		.fragment_specialization = &specialization,
+	};
+	ok = ok &&
+		harness_ok(
+			"graphics pipeline with VkSpecializationInfo", harness_pipeline(harness, &spec, render_pass, &pipeline));
+	check("specialization: pipeline creation accepts a specialization info", ok);
+	if (pipeline)
+		vkDestroyPipeline(harness->device, pipeline, NULL);
+	if (render_pass)
+		harness_destroy_render_pass(harness, render_pass, framebuffers);
+	if (layout)
+		vkDestroyPipelineLayout(harness->device, layout, NULL);
+}
