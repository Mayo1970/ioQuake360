+static bool specialization_value(const V4xShaderSpecialization *spec, const VkSpecializationInfo *info, float *value)
+{
+	*value = spec->default_value;
+	if (!info)
+		return true;
+	if (info->mapEntryCount && !info->pMapEntries)
+		return false;
+	for (uint32_t i = 0; i < info->mapEntryCount; i++) {
+		const VkSpecializationMapEntry *const entry = &info->pMapEntries[i];
+		if (entry->constantID != spec->constant_id)
+			continue;
+		if (entry->size != sizeof(uint32_t) || entry->offset > info->dataSize ||
+			entry->size > info->dataSize - entry->offset || !info->pData)
+			return false;
+		const uint8_t *const data = info->pData;
+		if (spec->type == V4X_SPECIALIZATION_FLOAT) {
+			memcpy(value, data + entry->offset, sizeof *value);
+			return true;
+		}
+		if (spec->type == V4X_SPECIALIZATION_BOOL || spec->type == V4X_SPECIALIZATION_UINT) {
+			uint32_t raw;
+			memcpy(&raw, data + entry->offset, sizeof raw);
+			*value = spec->type == V4X_SPECIALIZATION_BOOL ? (raw ? 1.0f : 0.0f) : (float)raw;
+			return true;
+		}
+		if (spec->type == V4X_SPECIALIZATION_INT) {
+			int32_t raw;
+			memcpy(&raw, data + entry->offset, sizeof raw);
+			*value = (float)raw;
+			return true;
+		}
+		return false;
+	}
+	return true;
+}
+
+static VkResult copy_specializations(const VkAllocationCallbacks *allocator, const V4xShader *shader,
+	const VkSpecializationInfo *info, PipelineSpecialization **out, uint32_t *out_count)
+{
+	*out_count = shader->specialization_count;
+	if (!*out_count)
+		return VK_SUCCESS;
+	*out = v4x_host_alloc(allocator, *out_count * sizeof **out, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+	if (!*out)
+		return VK_ERROR_OUT_OF_HOST_MEMORY;
+	for (uint32_t i = 0; i < *out_count; i++) {
+		const V4xShaderSpecialization *const spec = &shader->specializations[i];
+		float value;
+		if (!specialization_value(spec, info, &value))
+			return v4x_host_unsupported("specialization values must match their 4-byte scalar type");
+		(*out)[i] = (PipelineSpecialization){ spec->reg, value };
+	}
+	return VK_SUCCESS;
+}
+
